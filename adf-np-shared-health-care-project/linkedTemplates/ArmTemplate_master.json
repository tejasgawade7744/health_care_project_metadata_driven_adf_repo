{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-np-shared-health-care-project"
		},
		"ls_adls_health_care_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://healthcarestorageproject.dfs.core.windows.net/"
		},
		"ls_azuredatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1014-152517-9qkmv9nf"
		},
		"ls_kv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-health-care.vault.azure.net/"
		},
		"ls_metadata_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "helathcaremetadat.database.windows.net"
		},
		"ls_metadata_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "healthcare_project_metadata"
		},
		"ls_metadata_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "healthcare"
		},
		"ls_postgresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-curly-hat-b4w7e9sf-pooler.c-6.us-east-2.aws.neon.tech"
		},
		"ls_postgresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgresql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-np-shared-health-care-project_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_health_care_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_health_care_properties_typeProperties_url')]"
					},
					"ls_kv_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_kv_properties_typeProperties_baseUrl')]"
					},
					"ls_azuredatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_azuredatabricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_metadata_db_properties_typeProperties_server": {
						"value": "[parameters('ls_metadata_db_properties_typeProperties_server')]"
					},
					"ls_metadata_db_properties_typeProperties_database": {
						"value": "[parameters('ls_metadata_db_properties_typeProperties_database')]"
					},
					"ls_metadata_db_properties_typeProperties_userName": {
						"value": "[parameters('ls_metadata_db_properties_typeProperties_userName')]"
					},
					"ls_postgresql_properties_typeProperties_server": {
						"value": "[parameters('ls_postgresql_properties_typeProperties_server')]"
					},
					"ls_postgresql_properties_typeProperties_database": {
						"value": "[parameters('ls_postgresql_properties_typeProperties_database')]"
					},
					"ls_postgresql_properties_typeProperties_username": {
						"value": "[parameters('ls_postgresql_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}