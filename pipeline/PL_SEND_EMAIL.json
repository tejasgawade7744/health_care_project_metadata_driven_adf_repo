{
	"name": "PL_SEND_EMAIL",
	"properties": {
		"activities": [
			{
				"name": "Read_all_Table_Status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.audit_log where adf_run_id = '@{pipeline().parameters.adf_run_id}'\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azure_sql_metadata",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare Email body Header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Boday_header",
					"value": {
						"value": "Ingestion and Transformation process for caresync project has been completed and below is the status",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Email body Footer",
				"description": "For nay support please reach out to the tgawade690@gmail.com",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Boday_footer",
					"value": {
						"value": "For any support reach out to tgawade690@gmail.com",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Email subject",
				"description": "For nay support please reach out to the tgawade690@gmail.com",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Check overall failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if(greater(activity('Check overall failed count').output.firstRow.count, 0), 'Failed', 'Success')} | CareSync MASTER RUN\r\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check overall failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT COUNT(*) as count from ctrl.audit_log \nwhere adf_run_id = '@{pipeline().parameters.adf_run_id}' and STATUS != 'Success'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azure_sql_metadata",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Prepare Logic app Body",
				"description": "For nay support please reach out to the tgawade690@gmail.com",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare Email subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read_all_Table_Status",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email body Footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email body Header",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_app_body",
					"value": {
						"value": "{\r\n  \"subject\": \"@{variables('email_subject')}\",\r\n  \"email_recipients\": \"@{pipeline().globalParameters.email_recipients}\",\r\n  \"body_header\": \"@{variables('Boday_header')}\",\r\n  \"body_footer\": \"@{variables('Boday_footer')}\",\r\n  \"status_table\": @{string(activity('Read_all_Table_Status').output.value)}\r\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Send Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Prepare Logic app Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.logic_app_url",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('logic_app_body')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "5d7b82a9-348f-4b72-ab75-66f450dc1c1e"
			}
		},
		"variables": {
			"Boday_header": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_app_body": {
				"type": "String"
			},
			"Boday_footer": {
				"type": "String"
			}
		},
		"annotations": []
	}
}