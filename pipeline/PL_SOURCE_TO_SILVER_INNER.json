{
	"name": "PL_SOURCE_TO_SILVER_INNER",
	"properties": {
		"activities": [
			{
				"name": "Read_Table_Details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "\nselect * from ctrl.table_config\nwhere table_id = @{pipeline().parameters.Table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azure_sql_metadata",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set start time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "start time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Landing to Bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "check_source_system",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync-repo/caresync-adf-repo/landing_to_bronze",
					"baseParameters": {
						"source_system": {
							"value": "@activity('Read_Table_Details').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read_Table_Details').output.firstRow.source_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('start time')",
							"type": "Expression"
						},
						"source_file_format": {
							"value": "@coalesce(activity('Read_Table_Details').output.firstRow.source_file_format,'')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_azuredatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Bronze To Silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Landing to Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync-repo/caresync-adf-repo/bronze_to_silver",
					"baseParameters": {
						"table_name": {
							"value": "@activity('Read_Table_Details').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('start time')",
							"type": "Expression"
						},
						"merge_keys": {
							"value": "@coalesce(activity('Read_Table_Details').output.firstRow.merge_keys,'')",
							"type": "Expression"
						},
						"load_type": {
							"value": "@activity('Read_Table_Details').output.firstRow.load_type",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_azuredatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "update success status",
				"description": "",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Bronze To Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_metadata_db",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE ctrl.audit_log\nSET \nSTATUS = 'Success', end_time = SYSUTCDATETIME(),records_written=@{activity('Bronze To Silver').output.runOutput}\nwhere adf_run_id = '@{pipeline().parameters.adf_run_id}' and table_id = '@{pipeline().parameters.Table_id}';",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "check load type",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Read_Table_Details",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set start time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read_Table_Details').output.firstRow.load_type,'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Read_Watermeark",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select watermark_value from ctrl.watermark where \ntable_id =@{pipeline().parameters.Table_id}\n",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "ds_azure_sql_metadata",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Store_watermark_value",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Read_Watermeark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "watermark_value",
								"value": {
									"value": "@activity('Read_Watermeark').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Checking load type and update watermark",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "update success status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read_Table_Details').output.firstRow.load_type,'FULLL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Update watermark",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "ls_metadata_db",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update ctrl.watermark\nset watermark_value = SYSUTCDATETIME()\nwhere table_id = @{pipeline().parameters.Table_id}\n",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "check_source_system",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "check load type",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@activity('Read_Table_Details').output.firstRow.source_system",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "neon_postgres",
							"activities": [
								{
									"name": "Source_To_Landing",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "select * from PUBLIC.@{activity('Read_Table_Details').output.firstRow.source_table_name}\r\n@{if(\r\n    equals(activity('Read_Table_Details').output.firstRow.load_type,'FULL'),\r\n    '',\r\n    concat(\r\n        ' where ',\r\n        activity('Read_Table_Details').output.firstRow.watermark_column,\r\n        ' > ''',\r\n        variables('watermark_value'),\r\n        ''''\r\n    )\r\n)}\r\n",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_POSTGREY_SQL",
											"type": "DatasetReference"
										}
									],
									"outputs": [
										{
											"referenceName": "ls_health_care_landing",
											"type": "DatasetReference",
											"parameters": {
												"container": {
													"value": "landing",
													"type": "Expression"
												},
												"folder": {
													"value": "@concat(\n    activity('Read_Table_Details').output.firstRow.source_system,\n    '/',\n    activity('Read_Table_Details').output.firstRow.source_table_name, \n    '/',\n    variables('start time')\n)",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						},
						{
							"value": "adls_csv",
							"activities": [
								{
									"name": "ingest csv from source to landing",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": false,
												"modifiedDatetimeStart": {
													"value": "@variables('watermark_value')",
													"type": "Expression"
												},
												"deleteFilesAfterCompletion": false
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "DS_Source_csv_Binary",
											"type": "DatasetReference",
											"parameters": {
												"folder_name": {
													"value": "@activity('Read_Table_Details').output.firstRow.source_path",
													"type": "Expression"
												},
												"container_name": {
													"value": "soure",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_Source_csv_Binary",
											"type": "DatasetReference",
											"parameters": {
												"folder_name": {
													"value": "@concat(\n    activity('Read_Table_Details').output.firstRow.source_system,\n    '/',\n    activity('Read_Table_Details').output.firstRow.source_table_name, \n    '/',\n    variables('start time')\n)",
													"type": "Expression"
												},
												"container_name": "landing"
											}
										}
									]
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"Table_id": {
				"type": "int",
				"defaultValue": 1
			},
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"start time": {
				"type": "String"
			},
			"watermark_value": {
				"type": "String"
			}
		},
		"annotations": []
	}
}